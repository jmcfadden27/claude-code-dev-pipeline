{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lens",
    "verdict",
    "findings",
    "coverage"
  ],
  "properties": {
    "lens": {
      "type": "string",
      "enum": [
        "correctness",
        "security",
        "tests",
        "requirements"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "changes-requested"
      ],
      "description": "changes-requested when any finding with confidence 80 or more (the default minimum) has severity high."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "confidence",
          "file",
          "line",
          "title",
          "detail",
          "suggestion"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "confidence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "How sure you are this is a real defect, 0-100, after checking it in the code. Findings below the minimum set for the pipeline (80 by default) are not posted."
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 0,
            "description": "0 when the finding is not tied to one line."
          },
          "title": {
            "type": "string",
            "description": "The problem in under 80 characters."
          },
          "detail": {
            "type": "string",
            "description": "A concrete scenario: input or state, and what goes wrong."
          },
          "suggestion": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesChecked",
        "notChecked"
      ],
      "properties": {
        "filesChecked": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every changed file you read in full and checked for your lens, as paths relative to pr/."
        },
        "notChecked": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "reason"
            ],
            "properties": {
              "item": {
                "type": "string",
                "description": "A changed file, or something the pull request says was not verified, that you did not check."
              },
              "reason": {
                "type": "string",
                "description": "Why: out of time or turns, could not compare, not covered by your lens."
              }
            }
          },
          "description": "Anything relevant you did not check. Empty only when you checked everything for your lens."
        }
      }
    }
  }
}
